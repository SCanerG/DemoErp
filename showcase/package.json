{
  "name": "demoerp-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3400",
    "build": "tsc --noEmit && vite build && node scripts/verify-static.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/model.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.0.0",
    "sharp": "0.35.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "6.4.4"
  },
  "overrides": {
    "playwright-core": "1.64.0"
  }
}
