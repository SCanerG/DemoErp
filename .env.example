# Development placeholders only. Compose also supplies these defaults for one-command startup.
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=development-only-db-password
JWT_SECRET=development-only-change-me-jwt-signing-key-32bytes
JWT_ISSUER=catalog-api
JWT_AUDIENCE=catalog-web
JWT_LIFETIME_MINUTES=60
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_PORT=3000
BACKEND_PORT=5080
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5080/api

# Optional one-time Admin provisioning. Supply real values ONLY in ignored .env.
# Disable and remove the password after the first successful startup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional, backend-only AI. Disabled by default; never use VITE_ for credentials.
AI_ENABLED=false
AI_PROVIDER=OpenAI
AI_MODEL=gpt-4.1-mini-2025-04-14
AI_ENDPOINT=https://api.openai.com/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_TOOL_CALLS=5
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100

# Phase 11: bounded provider retries and AI-only content/metadata retention.
AI_MAX_RETRIES=1
AI_RETENTION_DAYS=7
# Development only: AI_ENABLED=true and AI_PROVIDER=Mock need no API key.

# Phase 11.1: canonical backend-only OpenAI settings override nonempty legacy AI_* values.
OPENAI_API_KEY=
OPENAI_MODEL=
# Empty OPENAI_MODEL falls back to AI_MODEL; AI_ENABLED stays false until explicitly enabled.

# Optional native Windows Development provider (not the container backend).
# OPENAI_MODEL and OPENAI_API_KEY are ignored when Provider=Ollama.
OLLAMA_MODEL=qwen3:8b
OLLAMA_ENDPOINT=http://127.0.0.1:11434

# Native Ollama context window; accepted range 2048..16384.
OLLAMA_CONTEXT_WINDOW=8192

# Optional local knowledge service (native .NET configuration keys).
# Keep disabled until PostgreSQL has pgvector and Ollama has nomic-embed-text.
Knowledge__Enabled=false
Knowledge__EmbeddingModel=nomic-embed-text
Knowledge__MaxFileBytes=5242880
Knowledge__ChunkCharacters=1200
Knowledge__OverlapCharacters=150
Knowledge__TopK=5
Knowledge__ContextCharacters=7000
Knowledge__TimeoutSeconds=90

# Optional native .NET proactive monitoring. Rules also default to disabled.
Monitoring__Enabled=false
Monitoring__PollSeconds=5
Monitoring__TimeoutSeconds=45
# Shared bounded local chat/embedding capacity; keep concurrency=1 for an 8 GB GPU.
LocalInference__Concurrency=1
LocalInference__QueueLimit=8

# Native .NET safe AI metadata and isolated deterministic evaluation lab.
AiQuality__Enabled=true
AiQuality__RetentionDays=7
AiQuality__MaxSpans=50000
AiQuality__MaxEvaluationRuns=200

# Native .NET visual workflows are opt-in; no scheduled ERP writes are enabled.
Workflows__Enabled=false
Workflows__PollSeconds=5
