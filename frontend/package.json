{
  "name": "demo-catalog-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "playwright test quality.spec.ts",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:ai": "playwright test ai.spec.ts ai-history.spec.ts ai-ollama.spec.ts agent-center.spec.ts",
    "test:ai-mock": "playwright test ai-development.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.2",
    "@xyflow/react": "12.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-is": "19.3.0",
    "react-router-dom": "^7.9.3",
    "recharts": "3.10.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.6",
    "vitest": "4.1.12"
  }
}
